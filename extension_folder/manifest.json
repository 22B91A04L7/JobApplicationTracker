{
    "manifest_version": 3,
    "name": "Job Application Tracker",
    "version": "1.0.0",
    "description": "Without react",
    "action": {
        "default_popup": "popup.html"
    },
    "background": {
        "service_worker": "background.js"
    },
    "permissions": [
        "activeTab",
        "storage",
        "scripting"
    ],
    "host_permissions": [
        "http://localhost:5000/*"
    ]
}