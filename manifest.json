{
  "manifest_version": 3,
  "name": "Job Application Tracker",
  "version": "1.0.0",
  "description": "Track job applications directly from job websites.",
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts" : [
    {
        "matches" : ["<all_urls>"],
        "js" : ["content.js"]
    }
  ]
}